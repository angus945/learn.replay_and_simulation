<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- One executable contains all lessons. These are source links, not copied domain implementations. -->
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Stages 01-02: the existing movement domain and application. -->
    <Compile Include="../../Assets/game/character-movement/src/Domain/**/*.cs" />
    <Compile Include="../../Assets/game/character-movement/src/Application/**/*.cs" />
    <!-- Stage 03: the existing definition and movement integration. -->
    <Compile Include="../gameplay-checks/MovementDefinitionExample.cs" Link="Existing/MovementDefinitionExample.cs" />
    <Compile Include="../../Assets/game/character-movement/src/Integration/**/*.cs" />
    <Compile Include="../../Assets/framework.deterministic-simulation/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.simulation-primitives/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.wave-dispatcher/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.tick-input-buffer/src/**/*.cs" />
    <!-- Stages 04-05: the real game definition, testability and modern recording/replay. -->
    <Compile Include="../../Assets/game/character-combat/src/**/*.cs" />
    <Compile Include="../../Assets/game/gameplay-simulation/src/**/*.cs" />
    <Compile Include="../../Assets/framework.testability/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.simulation-object-registry/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.seeded-random/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.invariant-checks/src/**/*.cs" />
    <Compile Include="../../Assets/modules/module.trace-buffer/src/**/*.cs" />
  </ItemGroup>
</Project>
